{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "inlineSources": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["index.ts", "playwright.ts", "src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
